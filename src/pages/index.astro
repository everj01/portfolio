---
// Layout
import Layout from "../layouts/Layout.astro";

//Componentes
import Navbar from "../components/Navbar.astro";
import AboutMe from "../components/AboutMe.astro";
import ExperienceMe from "../components/ExperienceMe.astro";
import ProjectsMe from "../components/ProjectsMe.astro";
import SkillsMe from "../components/SkillsMe.astro";
import EducationMe from "../components/EducationMe.astro";
import ContactMe from "../components/ContactMe.astro";
---

<Layout>
  <div class="flex flex-col min-h-screen">
    <Navbar />

    <main class="flex-1 bg-white dark:bg-gray-900 dark:text-white/90">
      <section id="aboutme"><AboutMe /></section>
      <section id="experienceme"><ExperienceMe /></section>
      <section id="projectsme"><ProjectsMe /></section>
      <section id="skillsme"><SkillsMe /></section>
      <section id="educationme"><EducationMe /></section>
      <section id="contactme"><ContactMe /></section>
    </main>

    <footer
      class="mt-auto w-full bg-gray-100 dark:bg-gray-800 py-6 border-t border-gray-300 dark:border-gray-700"
    >
      <p
        class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 px-4 text-center font-mono text-xs text-gray-500 dark:text-gray-400"
      >
        <span class="text-accent">ever@portfolio</span><span>:</span><span
          class="text-accent">~$</span
        >
      
        <span
          >echo "Hecho con Astro por <span
            class="font-semibold text-gray-700 dark:text-gray-200">Ever Montero</span
          > © {new Date().getFullYear()}"</span
        >
        <span
          class="inline-block h-3 w-[2px] animate-animateCaret bg-accent align-middle"
          aria-hidden="true"
        ></span>
      </p>
    </footer>
  </div>
</Layout>
