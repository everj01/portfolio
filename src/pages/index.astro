---
import Plantilla from "../layouts/Plantilla.astro";

import BarraNav from "../components/BarraNav.astro";
import SobreMi from "../components/SobreMi.astro";
import Experiencia from "../components/Experiencia.astro";
import Proyectos from "../components/Proyectos.astro";
import Habilidades from "../components/Habilidades.astro";
import Educacion from "../components/Educacion.astro";
import Contacto from "../components/Contacto.astro";
---

<Plantilla>
  <div class="flex flex-col min-h-screen">
    <BarraNav />

    <main class="flex-1 bg-white dark:bg-black dark:text-white/90">
      <section id="aboutme"><SobreMi /></section>
      <section id="experienceme"><Experiencia /></section>
      <section id="projectsme"><Proyectos /></section>
      <section id="skillsme"><Habilidades /></section>
      <section id="educationme"><Educacion /></section>
      <section id="contactme"><Contacto /></section>
    </main>

    <footer
      class="mt-auto w-full bg-gray-100 dark:bg-[#0a0a0a] py-6 border-t border-gray-300 dark:border-white/10"
    >
      <p
        class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 px-4 text-center font-mono text-xs text-gray-500 dark:text-gray-400"
      >
        <span class="text-accent">ever@portfolio</span><span>:</span><span
          class="text-accent">~$</span
        >
      
        <span
          >echo "Hecho con Astro por <span
            class="font-semibold text-gray-700 dark:text-gray-200">Ever Montero</span
          > © {new Date().getFullYear()}"</span
        >
        <span
          class="inline-block h-3 w-[2px] animate-animateCaret bg-accent align-middle"
          aria-hidden="true"
        ></span>
      </p>
    </footer>
  </div>
</Plantilla>
