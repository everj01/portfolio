---
import "../styles/global.css";
import Precarga from "../components/Precarga.astro";
import { getImage } from "astro:assets";
import perfil from "../assets/images/perfil.jpg";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ever Jesús Montero Minaya",
  description = "Portafolio de Ever Jesús Montero Minaya — Desarrollador Full Stack.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const urlCanonica = new URL(Astro.url.pathname, Astro.site);
const imagenOg = await getImage({ src: perfil, width: 1200, height: 1200 });
const urlImagenOg = new URL(imagenOg.src, Astro.site);

// Analytics: solo en produccion y si hay PUBLIC_GA_ID
const idGa = import.meta.env.PUBLIC_GA_ID;
const cargarAnalytics = import.meta.env.PROD && Boolean(idGa);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="shortcut icon" href={`${base}code.ico`} type="image/x-icon" />
    <link rel="canonical" href={urlCanonica} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={urlImagenOg} />
    <meta property="og:locale" content="es_PE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={urlCanonica} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlImagenOg} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    {
      cargarAnalytics && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${idGa}`}
          />
          <script is:inline define:vars={{ idGa }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", idGa);
          </script>
        </>
      )
    }

    {/* Tema guardado, antes de pintar, para que no parpadee */}
    <script is:inline>
      (function () {
        try {
          var guardado = localStorage.getItem("theme");
          var oscuro =
            guardado === "dark" ||
            (guardado === null &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", oscuro);
        } catch (e) {
          // Modo privado: no se puede leer
        }
      })();
    </script>
  </head>

  <body>
    <Precarga />
    <slot />
  </body>
</html>
