---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImagenLista } from "../types";

interface Props {
  imagenes: ImagenLista[];
  titulo?: string;
}

const { imagenes, titulo = "" } = Astro.props;
const varias = imagenes.length > 1;
const total = String(imagenes.length).padStart(2, "0");
---

<div class="flex flex-col gap-3" data-gallery data-gallery-count={imagenes.length}>
  {/* --- Escenario --- */}
  <div
    class="group/stage relative aspect-[16/10] w-full select-none overflow-hidden rounded-xl bg-gray-900 ring-1 ring-black/5 dark:ring-white/10"
    data-gallery-stage
  >
    {
      imagenes.length === 0 && (
        <div class="flex h-full w-full flex-col items-center justify-center gap-2 text-gray-500">
          <Icon name="lucide:image-off" class="h-8 w-8" aria-hidden="true" />
          <span class="text-xs">Sin capturas disponibles</span>
        </div>
      )
    }

    {
      imagenes.map((imagen, indice) => (
        <figure
          class:list={[
            "absolute inset-0 m-0 transition-opacity duration-300 ease-out",
            indice === 0 ? "opacity-100" : "pointer-events-none opacity-0",
          ]}
          data-slide={indice}
          data-active={indice === 0 ? "true" : undefined}
        >
          {/* Fondo difuminado para rellenar el marco */}
          {imagen.local ? (
            <Image
              src={imagen.local}
              alt=""
              aria-hidden="true"
              width={640}
              height={400}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full scale-110 object-cover opacity-30 blur-2xl"
            />
          ) : (
            <img
              src={imagen.ruta}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full scale-110 object-cover opacity-30 blur-2xl"
            />
          )}
          {imagen.local ? (
            <Image
              src={imagen.local}
              alt={imagen.descripcion || `${titulo} — captura ${indice + 1}`}
              data-caption={imagen.descripcion}
              width={1200}
              height={750}
              loading={indice === 0 ? "eager" : "lazy"}
              decoding="async"
              class="relative h-full w-full object-contain"
            />
          ) : (
            <img
              src={imagen.ruta}
              alt={imagen.descripcion || `${titulo} — captura ${indice + 1}`}
              data-caption={imagen.descripcion}
              loading={indice === 0 ? "eager" : "lazy"}
              decoding="async"
              class="relative h-full w-full object-contain"
            />
          )}
        </figure>
      ))
    }

    {/* Toda la imagen amplia */}
    {
      imagenes.length > 0 && (
        <button
          type="button"
          data-gallery-expand
          class="absolute inset-0 z-10 cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent"
        >
          <span class="sr-only">Ampliar imagen</span>
        </button>
      )
    }

    {/* Contador */}
    {
      varias && (
        <span
          class="pointer-events-none absolute left-3 top-3 z-20 rounded-md bg-black/55 px-2 py-1 font-mono text-[11px] tracking-widest text-white/90 backdrop-blur-sm"
          data-gallery-counter
        >
          01 / {total}
        </span>
      )
    }

    {/* Pista de ampliar */}
    {
      imagenes.length > 0 && (
        <span
          class="pointer-events-none absolute right-3 top-3 z-20 inline-flex items-center gap-1.5 rounded-md bg-black/55 px-2 py-1 text-[11px] font-medium text-white/90 backdrop-blur-sm transition-opacity md:opacity-0 md:group-hover/stage:opacity-100"
          aria-hidden="true"
        >
          <Icon name="lucide:maximize-2" class="h-3.5 w-3.5" />
          Ampliar
        </span>
      )
    }

    {/* Flechas */}
    {
      varias && (
        <>
          <button
            type="button"
            data-gallery-prev
            class="absolute left-2 top-1/2 z-20 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-full bg-black/45 text-white backdrop-blur-sm transition hover:bg-black/70 focus-visible:ring-2 focus-visible:ring-white/70 md:opacity-0 md:focus-visible:opacity-100 md:group-hover/stage:opacity-100"
            aria-label="Imagen anterior"
          >
            <Icon name="lucide:chevron-left" class="h-5 w-5" aria-hidden="true" />
          </button>
          <button
            type="button"
            data-gallery-next
            class="absolute right-2 top-1/2 z-20 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-full bg-black/45 text-white backdrop-blur-sm transition hover:bg-black/70 focus-visible:ring-2 focus-visible:ring-white/70 md:opacity-0 md:focus-visible:opacity-100 md:group-hover/stage:opacity-100"
            aria-label="Imagen siguiente"
          >
            <Icon name="lucide:chevron-right" class="h-5 w-5" aria-hidden="true" />
          </button>
        </>
      )
    }
  </div>

  {/* --- Descripcion --- */}
  <p
    class="min-h-[1.25rem] text-xs leading-relaxed text-gray-500 dark:text-gray-400"
    data-gallery-caption
  >
    {imagenes[0]?.descripcion ?? ""}
  </p>

  {/* --- Miniaturas --- */}
  {
    varias && (
      <div
        class="-mx-1 flex snap-x gap-2 overflow-x-auto px-1 pb-1 gallery-thumbs"
        role="tablist"
        aria-label="Capturas del proyecto"
      >
        {imagenes.map((imagen, indice) => (
          <button
            type="button"
            data-gallery-thumb={indice}
            role="tab"
            aria-selected={indice === 0 ? "true" : "false"}
            class:list={[
              "relative h-14 w-24 shrink-0 snap-start overflow-hidden rounded-lg ring-2 transition",
              indice === 0
                ? "ring-accent"
                : "opacity-60 ring-transparent hover:opacity-100",
            ]}
          >
            {imagen.local ? (
              <Image
                src={imagen.local}
                alt=""
                aria-hidden="true"
                width={192}
                height={112}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            ) : (
              <img
                src={imagen.ruta}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            )}
          </button>
        ))}
      </div>
    )
  }
</div>
