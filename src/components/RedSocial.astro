---
import { Icon } from "astro-icon/components";
import type { RedSocial } from "../types";

type Props = RedSocial;

const { url, icono, nombre, estilo } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={nombre}
  class:list={[
    "group flex h-9 w-9 items-center justify-center rounded-xl text-gray-600 transition-all duration-300 hover:-translate-y-0.5 hover:scale-110 dark:text-gray-300",
    estilo,
  ]}
>
  <Icon name={icono} class="h-5 w-5 transition-transform duration-300" aria-hidden="true" />
</a>
