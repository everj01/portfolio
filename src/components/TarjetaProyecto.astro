---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import EtiquetaTech from "./EtiquetaTech.astro";
import type { Proyecto } from "../types";
import { tieneDemo, normalizarImagenes, normalizarRepos } from "../utils/proyectos";

type Props = Proyecto & { indice: number };

const propiedades = Astro.props;
const { indice, titulo, descripcion, tecnologias = [], rol, anio, estado, urlDemo } = propiedades;

// Boton de demo
const mostrarDemo = tieneDemo(propiedades);

const imagenes = normalizarImagenes(propiedades.imagenes);
const portada = imagenes[0];

// Las capturas de movil son verticales (ej. 460x876). En la caja 16/10 hay que
// contenerlas, no recortarlas: se muestran enteras sobre una copia difuminada.
const esVertical = portada?.local ? portada.local.width < portada.local.height : false;

// Un repo abre el enlace directo; varios abren el selector
const repos = normalizarRepos(propiedades);
const mostrarGithub = repos.length > 0;
const repoUnico = repos.length === 1 ? repos[0] : null;

// Solo 4 etiquetas visibles, el resto se resume
const techVisibles = tecnologias.slice(0, 4);
const techRestantes = tecnologias.length - techVisibles.length;

const numero = String(indice + 1).padStart(2, "0");

// "Sistema de Control" -> "sistema-de-control"
const rutaCorta = (titulo ?? "")
  .toLowerCase()
  .normalize("NFD")
  .replace(/[\u0300-\u036F]/g, "") // quita acentos
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-+|-+$/g, "");
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border-2 border-gray-300 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-accent/70 hover:shadow-[0_18px_25px_-20px_rgba(0,0,0,0.35)] focus-within:border-accent/70 dark:border-white/[0.10] dark:bg-[#101010] dark:shadow-[0_10px_34px_-18px_rgba(161,181,207,0.22)] dark:hover:border-accent/50 dark:hover:shadow-[0_16px_46px_-16px_rgba(161,181,207,0.42)]"
>
  {/* --- Barra tipo terminal --- */}
  <div
    class="flex items-center gap-1.5 border-b border-gray-100 bg-gray-50/80 px-3 py-1.5 dark:border-white/10 dark:bg-white/[0.03]"
    aria-hidden="true"
  >
    <span class="h-2 w-2 rounded-full bg-red-400/70"></span>
    <span class="h-2 w-2 rounded-full bg-amber-400/70"></span>
    <span class="h-2 w-2 rounded-full bg-emerald-400/70"></span>
    <span class="ml-2 truncate font-mono text-[10px] text-gray-400 dark:text-gray-500">
      ~/projects/{rutaCorta}
    </span>
  </div>

  {/* --- Portada --- */}
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-gray-100 dark:bg-[#0a0a0a]">
    {
      portada ? (
        portada.local ? (
          <>
            {/* Relleno difuminado para que la vertical no deje franjas vacias */}
            {esVertical && (
              <Image
                src={portada.local}
                alt=""
                width={640}
                loading="lazy"
                decoding="async"
                aria-hidden="true"
                class="absolute inset-0 h-full w-full scale-110 object-cover opacity-30 blur-2xl"
              />
            )}
            <Image
              src={portada.local}
              alt={`Portada de ${titulo}`}
              width={640}
              loading="lazy"
              decoding="async"
              class:list={[
                "relative h-full w-full saturate-[0.85] transition-[filter,transform] duration-500 group-hover:scale-[1.03] group-hover:saturate-100",
                esVertical ? "object-contain" : "object-cover object-top",
              ]}
            />
          </>
        ) : (
          <img
            src={portada.ruta}
            alt={`Portada de ${titulo}`}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-top saturate-[0.85] transition-[filter,transform] duration-500 group-hover:scale-[1.03] group-hover:saturate-100"
          />
        )
      ) : (
        <div class="flex h-full w-full items-center justify-center text-gray-300 dark:text-gray-700">
          <Icon name="lucide:image" class="h-10 w-10" aria-hidden="true" />
        </div>
      )
    }

    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-black/5 to-transparent opacity-80"
      aria-hidden="true"
    >
    </div>

    {/* Disponibilidad del codigo */}
    <span
      class:list={[
        "absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-[11px] font-medium backdrop-blur-sm",
        mostrarGithub
          ? "bg-emerald-500/90 text-white"
          : "bg-black/50 text-white/85",
      ]}
    >
      <Icon
        name={mostrarGithub ? "simple-icons:github" : "lucide:lock"}
        class="h-3.5 w-3.5"
        aria-hidden="true"
      />
      {mostrarGithub ? "Código público" : "Código privado"}
    </span>

    {/* Estado del proyecto y acceso a la demo */}
    {
      (estado || mostrarDemo) && (
        <div class="absolute bottom-3 left-3 flex flex-wrap items-center gap-2">
          {estado && (
            <span class="inline-flex items-center gap-1.5 rounded-md bg-amber-500/90 px-2 py-1 text-[11px] font-medium text-white backdrop-blur-sm">
              <Icon name="lucide:loader" class="h-3.5 w-3.5" aria-hidden="true" />
              {estado}
            </span>
          )}
          {mostrarDemo && (
            <a
              href={urlDemo}
              target="_blank"
              rel="noopener noreferrer"
              class="relative z-20 inline-flex items-center gap-1.5 rounded-md bg-accent/90 px-2 py-1 text-[11px] font-semibold text-white backdrop-blur-sm transition-colors hover:bg-accent focus-visible:ring-2 focus-visible:ring-white/70"
              aria-label={`Ver la demo de ${titulo}`}
            >
              <Icon name="lucide:play" class="h-3.5 w-3.5" aria-hidden="true" />
              Demo
            </a>
          )}
        </div>
      )
    }

    {/* Cantidad de capturas */}
    {
      imagenes.length > 1 && (
        <span class="absolute bottom-3 right-3 inline-flex items-center gap-1.5 rounded-md bg-black/50 px-2 py-1 font-mono text-[11px] text-white/90 backdrop-blur-sm">
          <Icon name="lucide:layers" class="h-3.5 w-3.5" aria-hidden="true" />
          {imagenes.length}
        </span>
      )
    }
  </div>

  {/* --- Cuerpo --- */}
  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="flex items-start gap-3.5">
      {/* Numero de la tarjeta */}
      <span
        class="shrink-0 font-display text-[2.5rem] font-bold leading-[0.85] tracking-[-0.03em] tabular-nums text-accent/40 dark:text-accent/40"
        aria-hidden="true"
      >
        {numero}
      </span>

      <div class="min-w-0 space-y-2">
        {
          (rol || anio) && (
            <p class="font-mono text-[13px] uppercase tracking-[0.18em] text-gray-500 dark:text-gray-500">
              {[rol, anio].filter(Boolean).join(" · ")}
            </p>
          )
        }
        <h3
          class="text-lg font-bold leading-snug text-gray-900 transition-colors group-hover:text-accent dark:text-white"
        >
          {titulo}
        </h3>
        <p class="line-clamp-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
          {descripcion}
        </p>
      </div>
    </div>

    {/* Tecnologias */}
    <div class="mt-auto flex flex-wrap gap-1.5">
      {techVisibles.map((item) => <EtiquetaTech name={item} />)}
      {
        techRestantes > 0 && (
          <span class="inline-flex items-center rounded-md border border-dashed border-gray-300 px-2.5 py-1 text-[11px] font-medium text-gray-500 dark:border-white/15 dark:text-gray-400">
            +{techRestantes}
          </span>
        )
      }
    </div>

    {/* Acciones */}
    <div
      class="flex items-center justify-between border-t border-gray-100 pt-4 dark:border-white/10"
    >
      {
        repoUnico ? (
          <a
            href={repoUnico.url}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-20 inline-flex items-center gap-2 rounded-lg px-2 py-1 text-xs font-medium text-gray-600 transition-colors hover:text-accent dark:text-gray-400 dark:hover:text-accent"
          >
            <Icon name="simple-icons:github" class="h-4 w-4" aria-hidden="true" />
            Repositorio
          </a>
        ) : mostrarGithub ? (
          <button
            type="button"
            data-repo-trigger={indice}
            class="relative z-20 inline-flex items-center gap-2 rounded-lg px-2 py-1 text-xs font-medium text-gray-600 transition-colors hover:text-accent focus-visible:ring-2 focus-visible:ring-accent dark:text-gray-400 dark:hover:text-accent"
          >
            <Icon name="simple-icons:github" class="h-4 w-4" aria-hidden="true" />
            {repos.length} repositorios
          </button>
        ) : (
          <span class="inline-flex items-center gap-2 px-2 py-1 text-xs text-gray-400 dark:text-gray-500">
            <Icon name="lucide:lock" class="h-3.5 w-3.5" aria-hidden="true" />
            Sin repositorio público
          </span>
        )
      }

      <span
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-900 transition-colors group-hover:text-accent dark:text-white"
      >
        Ver detalle
        <Icon
          name="lucide:arrow-up-right"
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          aria-hidden="true"
        />
      </span>
    </div>
  </div>

  {/* Toda la tarjeta abre el detalle */}
  <button
    type="button"
    data-project-index={indice}
    class="project-view-more absolute inset-0 z-10 cursor-pointer rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900"
  >
    <span class="sr-only">Ver detalle de {titulo}</span>
  </button>
</article>
