---
import { Icon } from "astro-icon/components";
import { skillCategories } from "../data/data";

/* Tailwind no escanea data.json, asi que las clases que vienen de ahi
   ("bg-blue-500"...) nunca se generan. Por eso el color del JSON solo se usa
   como *nombre* y el estilo real se escribe aqui, estático y visible para
   Tailwind. Ademas asi el icono se ve igual de bien en claro y en oscuro. */
const TONES: Record<string, string> = {
  blue: "bg-blue-500/10 text-blue-600 ring-blue-500/20 dark:bg-blue-400/10 dark:text-blue-300 dark:ring-blue-400/20",
  green: "bg-emerald-500/10 text-emerald-600 ring-emerald-500/20 dark:bg-emerald-400/10 dark:text-emerald-300 dark:ring-emerald-400/20",
  emerald: "bg-emerald-500/10 text-emerald-600 ring-emerald-500/20 dark:bg-emerald-400/10 dark:text-emerald-300 dark:ring-emerald-400/20",
  purple: "bg-purple-500/10 text-purple-600 ring-purple-500/20 dark:bg-purple-400/10 dark:text-purple-300 dark:ring-purple-400/20",
  pink: "bg-pink-500/10 text-pink-600 ring-pink-500/20 dark:bg-pink-400/10 dark:text-pink-300 dark:ring-pink-400/20",
  orange: "bg-orange-500/10 text-orange-600 ring-orange-500/20 dark:bg-orange-400/10 dark:text-orange-300 dark:ring-orange-400/20",
  amber: "bg-amber-500/10 text-amber-600 ring-amber-500/20 dark:bg-amber-400/10 dark:text-amber-300 dark:ring-amber-400/20",
  red: "bg-red-500/10 text-red-600 ring-red-500/20 dark:bg-red-400/10 dark:text-red-300 dark:ring-red-400/20",
  cyan: "bg-cyan-500/10 text-cyan-600 ring-cyan-500/20 dark:bg-cyan-400/10 dark:text-cyan-300 dark:ring-cyan-400/20",
  gray: "bg-navy-500/10 text-navy-700 ring-navy-500/20 dark:bg-navy-300/10 dark:text-navy-200 dark:ring-navy-300/20",
};

/* "bg-blue-500" -> "blue". Si no esta mapeado, cae en el acento del sitio. */
const FALLBACK = "bg-accent/10 text-accent ring-accent/20";

const toneOf = (color?: string): string => {
  const key = color?.match(/bg-([a-z]+)-\d+/)?.[1] ?? "";
  return TONES[key] ?? FALLBACK;
};
---

<div class="flex flex-col items-center justify-center px-4 sm:px-6">
  <div class="mb-12 mt-32 text-center">
    <p class="section-tag mb-2">// 04 — skills.json</p>
    <h2
      class="font-display text-3xl font-bold tracking-[-0.02em] text-gray-900 md:text-4xl dark:text-white"
    >
      Habilidades Técnicas
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-[15px] leading-relaxed text-gray-600 dark:text-gray-400">
      Tecnologías con las que he trabajado, estudiado y desarrollado proyectos.
    </p>
    <div class="mx-auto mt-6 h-px w-24 bg-gradient-to-r from-transparent via-accent/50 to-transparent"></div>
  </div>

  <div class="grid w-full max-w-6xl grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      skillCategories.map((category) => {
        const tone = toneOf(category.color);
        return (
          <article
            class="group relative overflow-hidden rounded-2xl border border-gray-900/10 bg-white/80 p-6 shadow-[0_18px_44px_-32px_rgba(11,18,32,0.55)] backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent/30 hover:shadow-[0_26px_60px_-32px_rgba(11,18,32,0.6)] dark:border-white/[0.09] dark:bg-[#0a0a0a]/70 dark:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.05),0_16px_48px_-30px_rgba(161,181,207,0.26)] dark:hover:border-accent/40"
          >
            <div class="mb-5 flex items-center gap-3">
              <div
                class:list={[
                  "flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ring-1 transition-transform duration-300 group-hover:scale-105",
                  tone,
                ]}
              >
                {category.icon && (
                  <Icon name={category.icon} class="h-5 w-5" aria-hidden="true" />
                )}
              </div>
              <h3 class="text-lg font-semibold tracking-tight text-gray-900 dark:text-white">
                {category.title}
              </h3>
            </div>

            <ul class="divide-y divide-gray-900/[0.06] dark:divide-white/[0.06]">
              {category.skills?.map((skill) => (
                <li class="flex items-center gap-2.5 py-2.5 text-[15px] font-medium text-gray-700 dark:text-gray-300">
                  <span
                    class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent/60"
                    aria-hidden="true"
                  />
                  <span>{skill.name}</span>
                  {skill.level === "basic" && (
                    <span class="ml-auto shrink-0 rounded-full border border-gray-900/[0.07] px-2 py-0.5 text-[10px] font-normal uppercase tracking-[0.08em] text-gray-400/90 dark:border-white/[0.07] dark:text-gray-500">
                      básico
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </article>
        );
      })
    }
  </div>
</div>
