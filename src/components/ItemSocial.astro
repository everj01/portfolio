---
import { Icon } from "astro-icon/components";
import type { SocialItem } from "../types";

type Props = SocialItem;

const { url, icon, name, style } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={name}
  class:list={[
    "group flex h-9 w-9 items-center justify-center rounded-xl text-gray-600 transition-all duration-300 hover:-translate-y-0.5 hover:scale-110 dark:text-gray-300",
    style,
  ]}
>
  <Icon name={icon} class="h-5 w-5 transition-transform duration-300" aria-hidden="true" />
</a>
