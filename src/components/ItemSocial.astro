---
import { Icon } from "astro-icon/components";
import type { SocialItem } from "../types";

type Props = SocialItem;

const { url, icon, name, style } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={name}
  class:list={[
    "group transition-all duration-100 p-0 m-0 hover:-translate-y-1 hover:scale-125 pe-8 text-glow",
    style,
  ]}
>
  <Icon name={icon} class="h-6 w-6 transition-transform duration-100" aria-hidden="true" />
</a>
