---
import { Icon } from "astro-icon/components";
import { itemsPorject } from "../data/data";
import { normalizeRepos } from "../utils/projects";

// Selector de repositorio: solo aparece cuando un proyecto tiene mas de uno
// (frontend, backend, móvil...). Si tiene uno solo, la tarjeta y el detalle
// enlazan directo y este modal nunca se abre.
//
// Las listas se renderizan en el servidor (una por proyecto) y JS solo muestra
// la que toca, igual que hace ModalProject con los paneles de detalle.
const projects = itemsPorject.map((project) => ({
  title: project.title ?? "",
  repos: normalizeRepos(project),
}));

/** Pista corta para reconocer el repo de un vistazo: "everj01/web-portfolio". */
const repoPath = (url: string) => {
  try {
    return new URL(url).pathname.replace(/^\/+|\/+$/g, "");
  } catch {
    return url;
  }
};
---

<div
  id="repo-picker"
  class="fixed inset-0 z-[70] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Elegir repositorio"
>
  <div
    class="absolute inset-0 bg-gray-950/80 backdrop-blur-sm"
    data-repo-backdrop
    aria-hidden="true"
  >
  </div>

  <div
    id="repo-picker-panel"
    class="relative w-full max-w-md rounded-2xl border border-gray-200 bg-white p-5 shadow-2xl dark:border-white/10 dark:bg-[#0a0a0a]"
  >
    <div class="mb-4 flex items-start justify-between gap-4">
      <div class="flex flex-col gap-1">
        <p
          class="font-mono text-[11px] uppercase tracking-[0.18em] text-gray-400 dark:text-gray-500"
        >
          Repositorios
        </p>
        <p class="text-base font-bold text-gray-900 dark:text-white" data-repo-heading>
          Elige un repositorio
        </p>
      </div>

      <button
        id="repo-picker-close"
        type="button"
        class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-gray-200 text-gray-500 transition hover:bg-gray-100 hover:text-gray-900 focus-visible:ring-2 focus-visible:ring-accent dark:border-white/10 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
        aria-label="Cerrar selector de repositorios"
      >
        <Icon name="lucide:x" class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>

    {
      projects.map((project, index) =>
        project.repos.length > 1 ? (
          <ul class="flex flex-col gap-2" data-repo-list={index} hidden>
            {project.repos.map((repo) => (
              <li>
                <a
                  href={repo.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-3 rounded-xl border border-gray-200 px-3 py-2.5 transition-colors hover:border-accent/60 hover:bg-accent/5 focus-visible:ring-2 focus-visible:ring-accent dark:border-white/10 dark:hover:border-accent/60 dark:hover:bg-white/5"
                >
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-gray-100 text-gray-700 transition-colors group-hover:bg-accent group-hover:text-white dark:bg-white/5 dark:text-gray-200">
                    <Icon
                      name={repo.icon ?? "simple-icons:github"}
                      class="h-4 w-4"
                      aria-hidden="true"
                    />
                  </span>

                  <span class="flex min-w-0 flex-col">
                    <span class="truncate text-sm font-semibold text-gray-900 dark:text-white">
                      {repo.name}
                    </span>
                    <span class="truncate font-mono text-[11px] text-gray-500 dark:text-gray-400">
                      {repo.description || repoPath(repo.url)}
                    </span>
                  </span>

                  <Icon
                    name="lucide:arrow-up-right"
                    class="ml-auto h-4 w-4 shrink-0 text-gray-400 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))}
          </ul>
        ) : null
      )
    }
  </div>
</div>

<style>
  /* El atributo hidden es regla del navegador, asi que la clase `flex` de la
     lista lo ganaba y se veian los repos de todos los proyectos a la vez. */
  ul[data-repo-list][hidden] {
    display: none;
  }
</style>
