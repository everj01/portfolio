---
import { Icon } from "astro-icon/components";
import BotonTema from "./BotonTema.astro";
import { enlacesNav } from "../data/datos";
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:pt-4">
  <nav
    id="navbar"
    class="site-nav mx-auto flex items-center gap-2 rounded-2xl border px-2 py-2 sm:px-3 lg:grid lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]"
    aria-label="Navegación principal"
  >
    {/* ---------- Marca ---------- */}
    <div class="flex items-center lg:justify-self-start">
      <button
      type="button"
      id="navbar-brand"
      class="group flex shrink-0 items-center rounded-xl px-1.5 py-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
      aria-label="Volver al inicio"
    >
      <span
        class="font-display text-[19px] font-semibold leading-none tracking-tight text-gray-900 transition-colors duration-300 sm:text-xl dark:text-white"
      >
        Ever<span class="text-accent"> M.</span>
      </span>
      </button>
    </div>

    {/* ---------- Enlaces (escritorio) ---------- */}
    <ul
      id="navbar-links"
      class="relative hidden items-center gap-0.5 lg:flex lg:justify-self-center"
      role="list"
    >
      {/* Pastilla del enlace activo */}
      <li
        id="navbar-indicator"
        class="pointer-events-none absolute inset-y-0 left-0 -z-10 rounded-xl bg-accent/10 opacity-0 ring-1 ring-accent/20"
        aria-hidden="true"
      >
      </li>

      {
        enlacesNav.map((enlace) => (
          <li>
            <button
              type="button"
              data-section={enlace.seccion}
              class="nav-link group relative flex items-center gap-1.5 whitespace-nowrap rounded-xl px-2.5 py-2 text-[12.5px] font-medium text-gray-600 transition-colors duration-300 hover:text-gray-950 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 dark:text-gray-400 dark:hover:text-white xl:gap-2 xl:px-3 xl:text-[13px]"
            >
              <Icon
                name={enlace.icono}
                class="h-[17px] w-[17px] shrink-0 transition-transform duration-300 group-hover:scale-110"
                aria-hidden="true"
              />
              <span>{enlace.nombre}</span>
            </button>
          </li>
        ))
      }
    </ul>

    {/* ---------- Acciones ---------- */}
    <div class="ms-auto flex shrink-0 items-center gap-2 lg:ms-0 lg:justify-self-end">
      <span
        class="hidden h-6 w-px bg-gray-900/10 lg:block dark:bg-white/10"
        aria-hidden="true"
      >
      </span>

      <BotonTema />

      {/* Hamburguesa */}
      <button
        id="navbar-toggle"
        type="button"
        class="relative grid h-9 w-9 place-items-center rounded-xl border border-gray-900/10 text-gray-700 transition-colors duration-300 hover:bg-gray-900/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 lg:hidden dark:border-white/10 dark:text-gray-200 dark:hover:bg-white/5"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="navbar-menu"
      >
        <Icon
          name="lucide:menu"
          class="nav-burger-open absolute h-5 w-5 transition-all duration-300"
          aria-hidden="true"
        />
        <Icon
          name="lucide:x"
          class="nav-burger-close absolute h-5 w-5 transition-all duration-300"
          aria-hidden="true"
        />
      </button>
    </div>

    {/* ---------- Barra de progreso ---------- */}
    <span
      id="navbar-progress"
      class="pointer-events-none absolute inset-x-3 bottom-0 h-px origin-left scale-x-0 rounded-full bg-gradient-to-r from-transparent via-accent to-transparent opacity-0 transition-opacity duration-500"
      aria-hidden="true"
    >
    </span>
  </nav>

  {/* ---------- Menu móvil ---------- */}
  <div
    id="navbar-menu"
    class="site-nav-menu mx-auto mt-2 overflow-hidden rounded-2xl border lg:hidden"
  >
    <ul class="flex flex-col gap-1 p-2" role="list">
      {
        enlacesNav.map((enlace, indice) => (
          <li class="nav-mobile-item" style={`--i:${indice}`}>
            <button
              type="button"
              data-section={enlace.seccion}
              class="nav-link-mobile group flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-gray-700 transition-colors duration-200 hover:bg-accent/10 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 dark:text-gray-300 dark:hover:text-white"
            >
              <Icon name={enlace.icono} class="h-[18px] w-[18px] shrink-0" aria-hidden="true" />
              <span>{enlace.nombre}</span>
              <Icon
                name="lucide:arrow-up-right"
                class="ms-auto h-4 w-4 opacity-0 transition-opacity duration-200 group-hover:opacity-100"
                aria-hidden="true"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  import { irASeccion } from "../utils/scroll";

  const nav = document.getElementById("navbar");
  const boton = document.getElementById("navbar-toggle");
  const menu = document.getElementById("navbar-menu");
  const marca = document.getElementById("navbar-brand");
  const progreso = document.getElementById("navbar-progress");
  const pastilla = document.getElementById("navbar-indicator");

  const enlaces = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".nav-link")
  );
  const enlacesMovil = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".nav-link-mobile")
  );

  // Altura del navbar, se descuenta al hacer scroll
  function margenNav(): number {
    return (nav?.offsetHeight ?? 56) + 24;
  }

  /* ---------- Menu móvil ---------- */

  function ponerMenu(abierto: boolean): void {
    menu?.classList.toggle("is-open", abierto);
    nav?.classList.toggle("menu-open", abierto);
    boton?.classList.toggle("is-open", abierto);
    boton?.setAttribute("aria-expanded", String(abierto));
    boton?.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
  }

  boton?.addEventListener("click", () => {
    ponerMenu(!menu?.classList.contains("is-open"));
  });

  // Cerrar al tocar fuera o al pasar a escritorio
  document.addEventListener("click", (evento) => {
    if (!menu?.classList.contains("is-open")) return;

    const destino = evento.target as Node;
    if (!menu.contains(destino) && !nav?.contains(destino)) ponerMenu(false);
  });

  window.matchMedia("(min-width: 1024px)").addEventListener("change", (evento) => {
    if (evento.matches) ponerMenu(false);
  });

  /* ---------- Pastilla deslizante ---------- */

  let enlaceActivo: HTMLButtonElement | null = null;

  function moverPastilla(): void {
    if (!pastilla) return;

    if (!enlaceActivo) {
      pastilla.style.opacity = "0";
      return;
    }

    pastilla.style.width = `${enlaceActivo.offsetWidth}px`;
    pastilla.style.transform = `translateX(${enlaceActivo.offsetLeft}px)`;
    pastilla.style.opacity = "1";
  }

  function marcarActivo(seccion: string): void {
    const siguiente = enlaces.find((enlace) => enlace.dataset.section === seccion) ?? null;
    if (siguiente === enlaceActivo) return;

    enlaceActivo = siguiente;

    enlaces.forEach((enlace) => {
      const activo = enlace === siguiente;
      enlace.classList.toggle("is-active", activo);

      if (activo) enlace.setAttribute("aria-current", "true");
      else enlace.removeAttribute("aria-current");
    });

    enlacesMovil.forEach((enlace) => {
      enlace.classList.toggle("is-active", enlace.dataset.section === seccion);
    });

    moverPastilla();
  }

  /* ---------- Scroll ---------- */

  const secciones = Array.from(
    document.querySelectorAll<HTMLElement>("main > section[id]")
  );

  let enCola = false;

  function alHacerScroll(): void {
    const y = window.scrollY;

    // Nav compacto
    nav?.classList.toggle("is-scrolled", y > 24);

    // Progreso
    if (progreso) {
      const maximo = document.documentElement.scrollHeight - window.innerHeight;
      const avance = maximo > 0 ? Math.min(y / maximo, 1) : 0;
      progreso.style.transform = `scaleX(${avance})`;
      progreso.style.opacity = y > 24 ? "1" : "0";
    }

    // Seccion activa: la ultima que ya paso la linea de referencia
    const linea = y + margenNav() + window.innerHeight * 0.2;
    let actual = secciones[0]?.id ?? "";

    for (const seccion of secciones) {
      if (seccion.offsetTop <= linea) actual = seccion.id;
    }

    // Al final de la pagina gana la ultima seccion
    if (window.innerHeight + y >= document.documentElement.scrollHeight - 2) {
      actual = secciones[secciones.length - 1]?.id ?? actual;
    }

    marcarActivo(actual);
    enCola = false;
  }

  function pedirScroll(): void {
    if (enCola) return;

    enCola = true;
    requestAnimationFrame(alHacerScroll);
  }

  window.addEventListener("scroll", pedirScroll, { passive: true });
  window.addEventListener("resize", () => {
    moverPastilla();
    pedirScroll();
  });

  /* ---------- Navegacion ---------- */

  [...enlaces, ...enlacesMovil].forEach((enlace) => {
    enlace.addEventListener("click", () => {
      irASeccion(enlace.dataset.section ?? "", margenNav());
      ponerMenu(false);
    });
  });

  marca?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
    ponerMenu(false);
  });

  // Estado inicial
  requestAnimationFrame(alHacerScroll);
  window.addEventListener("load", moverPastilla);

  // Las fuentes cambian el ancho de los enlaces
  document.fonts?.ready.then(moverPastilla);
</script>
