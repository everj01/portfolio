---
import { Icon } from "astro-icon/components";
import ProjectDetail from "./ProjectDetail.astro";
import RepoPicker from "./RepoPicker.astro";
import { itemsPorject } from "../data/data";

// Cada proyecto se renderiza en el servidor dentro del modal y se muestra
// el que toque. Asi los iconos y las imagenes son HTML real (nada se arma
// con JS) y no hace falta Swiper.
---

<div
  id="project-modal"
  class="fixed inset-0 z-50 hidden overflow-y-auto overscroll-contain"
  role="dialog"
  aria-modal="true"
>
  {/* Fondo */}
  <div
    class="fixed inset-0 bg-gray-950/70 backdrop-blur-sm"
    data-modal-backdrop
    aria-hidden="true"
  >
  </div>

  <div class="relative flex min-h-full items-start justify-center p-3 sm:p-6 lg:items-center">
    <div
      id="project-modal-panel"
      class="relative w-full max-w-6xl rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-white/10 dark:bg-gray-900"
    >
      <button
        id="project-modal-close"
        type="button"
        class="absolute right-3 top-3 z-20 grid h-9 w-9 place-items-center rounded-full border border-gray-200 bg-white/90 text-gray-600 backdrop-blur transition hover:bg-gray-100 hover:text-gray-900 focus-visible:ring-2 focus-visible:ring-accent dark:border-white/10 dark:bg-gray-800/90 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white"
        aria-label="Cerrar detalle"
      >
        <Icon name="lucide:x" class="h-4 w-4" aria-hidden="true" />
      </button>

      <div class="p-4 sm:p-6 lg:p-8">
        {
          itemsPorject.map((project, index) => (
            <div data-project-panel={index} hidden>
              <ProjectDetail {...project} index={index} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

{/* Vista ampliada de una captura: ocupa la pantalla y trae sus propios
   controles (contador, flechas, zoom y miniaturas) para no obligar a cerrar
   y volver a abrir en cada imagen. */}
<div
  id="project-lightbox"
  class="fixed inset-0 z-[60] hidden flex-col bg-gray-950/95"
  role="dialog"
  aria-modal="true"
  aria-label="Imagen ampliada"
>
  {/* --- Barra superior --- */}
  <div class="flex shrink-0 items-center justify-between gap-3 px-4 py-3">
    <span
      id="project-lightbox-counter"
      class="font-mono text-[11px] tracking-widest text-white/70"
    >
    </span>

    <div class="flex items-center gap-2">
      <button
        id="project-lightbox-zoom"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-2 text-xs font-medium text-white transition hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-white/70"
        aria-pressed="false"
      >
        <Icon
          name="lucide:zoom-in"
          class="h-4 w-4"
          aria-hidden="true"
          data-zoom-icon="in"
        />
        <Icon
          name="lucide:zoom-out"
          class="hidden h-4 w-4"
          aria-hidden="true"
          data-zoom-icon="out"
        />
        <span class="hidden sm:inline" data-zoom-label>Zoom</span>
      </button>

      <button
        id="project-lightbox-close"
        type="button"
        class="grid h-9 w-9 place-items-center rounded-full bg-white/10 text-white transition hover:bg-white/20 focus-visible:ring-2 focus-visible:ring-white/70"
        aria-label="Cerrar imagen ampliada"
      >
        <Icon name="lucide:x" class="h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  {/* --- Escenario --- */}
  <div id="project-lightbox-stage" class="relative min-h-0 flex-1">
    <div
      id="project-lightbox-scroll"
      class="flex h-full w-full overflow-hidden overscroll-contain px-4"
    >
      <img
        id="project-lightbox-image"
        src=""
        alt=""
        class="m-auto block max-h-full max-w-full cursor-zoom-in rounded-lg object-contain"
      />
    </div>

    <button
      id="project-lightbox-prev"
      type="button"
      class="absolute left-3 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white backdrop-blur-sm transition hover:bg-white/25 focus-visible:ring-2 focus-visible:ring-white/70"
      aria-label="Imagen anterior"
    >
      <Icon name="lucide:chevron-left" class="h-6 w-6" aria-hidden="true" />
    </button>
    <button
      id="project-lightbox-next"
      type="button"
      class="absolute right-3 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white backdrop-blur-sm transition hover:bg-white/25 focus-visible:ring-2 focus-visible:ring-white/70"
      aria-label="Imagen siguiente"
    >
      <Icon name="lucide:chevron-right" class="h-6 w-6" aria-hidden="true" />
    </button>
  </div>

  {/* --- Pie: descripcion y miniaturas --- */}
  <div class="shrink-0 px-4 pb-4 pt-3">
    <p
      id="project-lightbox-caption"
      class="mb-3 text-center text-xs leading-relaxed text-white/70"
    >
    </p>

    <div
      id="project-lightbox-thumbs"
      class="mx-auto flex max-w-3xl snap-x justify-start gap-2 overflow-x-auto pb-1 gallery-thumbs sm:justify-center"
      role="tablist"
      aria-label="Capturas del proyecto"
      style="display: none"
      hidden
    >
    </div>
  </div>
</div>

{/* Selector para los proyectos con mas de un repositorio */}
<RepoPicker />

<script>
  type Gallery = {
    root: HTMLElement;
    slides: HTMLElement[];
    thumbs: HTMLButtonElement[];
    counter: HTMLElement | null;
    caption: HTMLElement | null;
    index: number;
  };

  const modal = document.getElementById("project-modal");
  const panel = document.getElementById("project-modal-panel");
  const closeBtn = document.getElementById("project-modal-close");
  const backdrop = modal?.querySelector<HTMLElement>("[data-modal-backdrop]");

  const lightbox = document.getElementById("project-lightbox");
  const lightboxImg = document.getElementById(
    "project-lightbox-image"
  ) as HTMLImageElement | null;
  const lightboxCaption = document.getElementById("project-lightbox-caption");
  const lightboxClose = document.getElementById("project-lightbox-close");
  const lightboxCounter = document.getElementById("project-lightbox-counter");
  const lightboxScroll = document.getElementById("project-lightbox-scroll");
  const lightboxThumbs = document.getElementById("project-lightbox-thumbs");
  const lightboxPrev = document.getElementById("project-lightbox-prev");
  const lightboxNext = document.getElementById("project-lightbox-next");
  const lightboxZoom = document.getElementById("project-lightbox-zoom");

  const panels = Array.from(
    modal?.querySelectorAll<HTMLElement>("[data-project-panel]") ?? []
  );

  const galleries = new Map<HTMLElement, Gallery>();
  let activeGallery: Gallery | null = null;
  let lastFocused: HTMLElement | null = null;
  let zoomed = false;

  const pad = (value: number) => String(value).padStart(2, "0");

  /* ---------- Galeria ---------- */

  const render = (gallery: Gallery) => {
    gallery.slides.forEach((slide, i) => {
      const active = i === gallery.index;
      slide.classList.toggle("opacity-100", active);
      slide.classList.toggle("opacity-0", !active);
      slide.classList.toggle("pointer-events-none", !active);
      if (active) slide.dataset.active = "true";
      else delete slide.dataset.active;
    });

    gallery.thumbs.forEach((thumb, i) => {
      const active = i === gallery.index;
      thumb.classList.toggle("ring-accent", active);
      thumb.classList.toggle("ring-transparent", !active);
      thumb.classList.toggle("opacity-60", !active);
      thumb.setAttribute("aria-selected", String(active));
      if (active) {
        thumb.scrollIntoView({ block: "nearest", inline: "nearest" });
      }
    });

    if (gallery.counter) {
      gallery.counter.textContent = `${pad(gallery.index + 1)} / ${pad(
        gallery.slides.length
      )}`;
    }

    if (gallery.caption) {
      const img = gallery.slides[gallery.index]?.querySelector<HTMLImageElement>(
        "img:not([aria-hidden])"
      );
      gallery.caption.textContent = img?.dataset.caption ?? "";
    }

    if (lightbox && !lightbox.classList.contains("hidden")) syncLightbox(gallery);
  };

  const goTo = (gallery: Gallery, index: number) => {
    const total = gallery.slides.length;
    if (total === 0) return;
    gallery.index = (index + total) % total;
    render(gallery);
  };

  const setupGallery = (root: HTMLElement): Gallery => {
    // La descripcion de cada imagen viaja en data-caption del propio <img>.
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));

    const gallery: Gallery = {
      root,
      slides,
      thumbs: Array.from(
        root.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")
      ),
      counter: root.querySelector<HTMLElement>("[data-gallery-counter]"),
      caption: root.querySelector<HTMLElement>("[data-gallery-caption]"),
      index: 0,
    };

    root
      .querySelector<HTMLButtonElement>("[data-gallery-prev]")
      ?.addEventListener("click", () => goTo(gallery, gallery.index - 1));

    root
      .querySelector<HTMLButtonElement>("[data-gallery-next]")
      ?.addEventListener("click", () => goTo(gallery, gallery.index + 1));

    gallery.thumbs.forEach((thumb, i) => {
      thumb.addEventListener("click", () => goTo(gallery, i));
    });

    root
      .querySelector<HTMLButtonElement>("[data-gallery-expand]")
      ?.addEventListener("click", () => openLightbox(gallery));

    // Deslizar en tactil
    const stage = root.querySelector<HTMLElement>("[data-gallery-stage]");
    let startX = 0;
    let startY = 0;

    stage?.addEventListener(
      "touchstart",
      (event) => {
        startX = event.changedTouches[0]?.clientX ?? 0;
        startY = event.changedTouches[0]?.clientY ?? 0;
      },
      { passive: true }
    );

    stage?.addEventListener(
      "touchend",
      (event) => {
        const deltaX = (event.changedTouches[0]?.clientX ?? 0) - startX;
        const deltaY = (event.changedTouches[0]?.clientY ?? 0) - startY;
        // Solo si el gesto es claramente horizontal, para no robar el scroll.
        if (Math.abs(deltaX) > 45 && Math.abs(deltaX) > Math.abs(deltaY)) {
          goTo(gallery, gallery.index + (deltaX < 0 ? 1 : -1));
        }
      },
      { passive: true }
    );

    galleries.set(root, gallery);
    return gallery;
  };

  /* ---------- Imagen ampliada ---------- */

  /** Imagen grande (no el fondo difuminado) de una diapositiva. */
  const slideImage = (gallery: Gallery, index: number) =>
    gallery.slides[index]?.querySelector<HTMLImageElement>("img:not([aria-hidden])") ??
    null;

  const setZoom = (on: boolean) => {
    if (!lightboxImg || !lightboxScroll) return;
    zoomed = on;

    lightboxScroll.classList.toggle("overflow-auto", on);
    lightboxScroll.classList.toggle("overflow-hidden", !on);
    lightboxImg.classList.toggle("max-h-full", !on);
    lightboxImg.classList.toggle("max-w-full", !on);
    lightboxImg.classList.toggle("w-[180%]", on);
    lightboxImg.classList.toggle("cursor-zoom-in", !on);
    lightboxImg.classList.toggle("cursor-zoom-out", on);

    lightboxZoom?.setAttribute("aria-pressed", String(on));
    lightboxZoom
      ?.querySelector("[data-zoom-icon='in']")
      ?.classList.toggle("hidden", on);
    lightboxZoom
      ?.querySelector("[data-zoom-icon='out']")
      ?.classList.toggle("hidden", !on);
    const label = lightboxZoom?.querySelector("[data-zoom-label]");
    if (label) label.textContent = on ? "Reducir" : "Zoom";

    if (on) {
      // Arranca el zoom centrado, no pegado a la esquina.
      lightboxScroll.scrollLeft =
        (lightboxScroll.scrollWidth - lightboxScroll.clientWidth) / 2;
      lightboxScroll.scrollTop =
        (lightboxScroll.scrollHeight - lightboxScroll.clientHeight) / 2;
    }
  };

  /** Tira de miniaturas propia del visor: se arma con las de la galeria. */
  const buildLightboxThumbs = (gallery: Gallery) => {
    if (!lightboxThumbs) return;

    lightboxThumbs.innerHTML = "";

    // La clase `flex` gana al atributo hidden, asi que se oculta por estilo.
    const single = gallery.slides.length < 2;
    lightboxThumbs.hidden = single;
    lightboxThumbs.style.display = single ? "none" : "";
    if (single) return;

    gallery.slides.forEach((_, i) => {
      const source =
        gallery.thumbs[i]?.querySelector<HTMLImageElement>("img") ??
        slideImage(gallery, i);

      const button = document.createElement("button");
      button.type = "button";
      button.setAttribute("role", "tab");
      button.dataset.lightboxThumb = String(i);
      button.className =
        "relative h-12 w-20 shrink-0 snap-start overflow-hidden rounded-lg ring-2 ring-transparent transition hover:opacity-100 focus-visible:ring-white";
      button.setAttribute("aria-label", `Ver captura ${i + 1}`);

      const image = document.createElement("img");
      image.src = source?.currentSrc || source?.src || "";
      image.alt = "";
      image.loading = "lazy";
      image.decoding = "async";
      image.className = "h-full w-full object-cover";
      button.appendChild(image);

      button.addEventListener("click", () => goTo(gallery, i));
      lightboxThumbs.appendChild(button);
    });
  };

  const syncLightbox = (gallery: Gallery) => {
    const img = slideImage(gallery, gallery.index);
    if (!img || !lightboxImg) return;

    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    if (lightboxCaption) lightboxCaption.textContent = img.dataset.caption ?? "";

    const total = gallery.slides.length;
    if (lightboxCounter) {
      lightboxCounter.textContent =
        total > 1 ? `${pad(gallery.index + 1)} / ${pad(total)}` : "";
    }

    const single = total < 2;
    lightboxPrev?.classList.toggle("hidden", single);
    lightboxNext?.classList.toggle("hidden", single);

    lightboxThumbs
      ?.querySelectorAll<HTMLButtonElement>("[data-lightbox-thumb]")
      .forEach((thumb, i) => {
        const active = i === gallery.index;
        thumb.classList.toggle("ring-white", active);
        thumb.classList.toggle("ring-transparent", !active);
        thumb.classList.toggle("opacity-50", !active);
        thumb.setAttribute("aria-selected", String(active));
        if (active) thumb.scrollIntoView({ block: "nearest", inline: "nearest" });
      });

    // Cada imagen nueva empieza sin zoom, si no se queda desencuadrada.
    setZoom(false);
  };

  const openLightbox = (gallery: Gallery) => {
    if (!lightbox) return;
    buildLightboxThumbs(gallery);
    syncLightbox(gallery);
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    lightboxClose?.focus();
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    setZoom(false);
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
  };

  /* ---------- Modal ---------- */

  const isOpen = () => modal !== null && !modal.classList.contains("hidden");

  const openModal = (index: number) => {
    const target = panels[index];
    if (!modal || !target) return;

    lastFocused = document.activeElement as HTMLElement | null;

    panels.forEach((item) => {
      item.hidden = item !== target;
    });

    const galleryRoot = target.querySelector<HTMLElement>("[data-gallery]");
    if (galleryRoot) {
      activeGallery = galleries.get(galleryRoot) ?? setupGallery(galleryRoot);
      goTo(activeGallery, 0);
    } else {
      activeGallery = null;
    }

    const title = target.querySelector("h3");
    if (title?.id) modal.setAttribute("aria-labelledby", title.id);

    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    modal.scrollTop = 0;
    closeBtn?.focus();
  };

  const closeModal = () => {
    if (!modal) return;
    closeLightbox();
    modal.classList.add("hidden");
    document.body.style.overflow = "";
    activeGallery = null;
    lastFocused?.focus();
  };

  document
    .querySelectorAll<HTMLButtonElement>("button.project-view-more")
    .forEach((button) => {
      button.addEventListener("click", () => {
        openModal(Number(button.dataset.projectIndex));
      });
    });

  closeBtn?.addEventListener("click", closeModal);
  backdrop?.addEventListener("click", closeModal);
  lightboxClose?.addEventListener("click", closeLightbox);

  // Clic en el hueco alrededor de la imagen: cierra. Sobre la imagen: zoom.
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox || event.target === lightboxScroll) closeLightbox();
  });

  lightboxImg?.addEventListener("click", () => setZoom(!zoomed));
  lightboxZoom?.addEventListener("click", () => setZoom(!zoomed));

  lightboxPrev?.addEventListener("click", () => {
    if (activeGallery) goTo(activeGallery, activeGallery.index - 1);
  });

  lightboxNext?.addEventListener("click", () => {
    if (activeGallery) goTo(activeGallery, activeGallery.index + 1);
  });

  // Deslizar dentro del visor (solo sin zoom, para no pelearse con el paneo).
  let lightboxStartX = 0;
  let lightboxStartY = 0;

  lightboxScroll?.addEventListener(
    "touchstart",
    (event) => {
      lightboxStartX = event.changedTouches[0]?.clientX ?? 0;
      lightboxStartY = event.changedTouches[0]?.clientY ?? 0;
    },
    { passive: true }
  );

  lightboxScroll?.addEventListener(
    "touchend",
    (event) => {
      if (zoomed || !activeGallery || activeGallery.slides.length < 2) return;
      const deltaX = (event.changedTouches[0]?.clientX ?? 0) - lightboxStartX;
      const deltaY = (event.changedTouches[0]?.clientY ?? 0) - lightboxStartY;
      if (Math.abs(deltaX) > 45 && Math.abs(deltaX) > Math.abs(deltaY)) {
        goTo(activeGallery, activeGallery.index + (deltaX < 0 ? 1 : -1));
      }
    },
    { passive: true }
  );

  // Click fuera del panel (zona de relleno alrededor)
  modal?.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (panel && !panel.contains(target) && target !== backdrop) closeModal();
  });

  /* ---------- Selector de repositorios ---------- */

  const repoPicker = document.getElementById("repo-picker");
  const repoPickerPanel = document.getElementById("repo-picker-panel");
  const repoPickerClose = document.getElementById("repo-picker-close");
  const repoHeading = repoPicker?.querySelector<HTMLElement>("[data-repo-heading]");

  const repoLists = Array.from(
    repoPicker?.querySelectorAll<HTMLElement>("[data-repo-list]") ?? []
  );

  const repoPickerOpen = () =>
    repoPicker !== null && !repoPicker.classList.contains("hidden");

  let repoLastFocused: HTMLElement | null = null;

  const openRepoPicker = (index: number, title: string) => {
    const list = repoLists.find((item) => item.dataset.repoList === String(index));
    if (!repoPicker || !list) return;

    repoLastFocused = document.activeElement as HTMLElement | null;
    repoLists.forEach((item) => {
      item.hidden = item !== list;
    });

    if (repoHeading) repoHeading.textContent = title || "Elige un repositorio";

    repoPicker.classList.remove("hidden");
    repoPicker.classList.add("flex");
    document.body.style.overflow = "hidden";
    list.querySelector<HTMLAnchorElement>("a")?.focus();
  };

  const closeRepoPicker = () => {
    if (!repoPicker) return;
    repoPicker.classList.add("hidden");
    repoPicker.classList.remove("flex");
    // Si el detalle sigue abierto, el scroll del fondo debe seguir bloqueado.
    if (!isOpen()) document.body.style.overflow = "";
    repoLastFocused?.focus();
  };

  document
    .querySelectorAll<HTMLButtonElement>("[data-repo-trigger]")
    .forEach((button) => {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        const index = Number(button.dataset.repoTrigger);
        const title =
          button
            .closest("article, [data-project-panel]")
            ?.querySelector("h3")
            ?.textContent?.trim() ?? "";
        openRepoPicker(index, title);
      });
    });

  repoPickerClose?.addEventListener("click", closeRepoPicker);

  repoPicker?.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (repoPickerPanel && !repoPickerPanel.contains(target)) closeRepoPicker();
  });

  // Al elegir un repo se abre en otra pestaña: el selector ya no hace falta.
  repoPicker?.querySelectorAll("a[href]").forEach((link) => {
    link.addEventListener("click", closeRepoPicker);
  });

  document.addEventListener("keydown", (event) => {
    if (repoPickerOpen()) {
      if (event.key === "Escape") closeRepoPicker();
      return;
    }

    if (!isOpen()) return;

    const lightboxOpen = lightbox !== null && !lightbox.classList.contains("hidden");

    if (event.key === "Escape") {
      lightboxOpen ? closeLightbox() : closeModal();
      return;
    }

    if (!activeGallery || activeGallery.slides.length < 2) return;

    if (event.key === "ArrowLeft") {
      event.preventDefault();
      goTo(activeGallery, activeGallery.index - 1);
    } else if (event.key === "ArrowRight") {
      event.preventDefault();
      goTo(activeGallery, activeGallery.index + 1);
    }
  });
</script>
